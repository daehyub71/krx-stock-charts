# KRX 로그인 자격증명 (pykrx 1.2.8+ 필요)
# 종목목록·지수구성종목 조회에 필요하다. OHLCV 조회는 로그인 없이도 동작한다.
# http://data.krx.co.kr 회원가입 후 발급받은 계정을 입력한다.
#
# 이 파일(.env.example)은 커밋되지만, 실제 값이 담긴 .env는 .gitignore로 제외된다.
# GitHub Actions에서는 리포지토리 Secrets(KRX_ID, KRX_PW)로 주입한다.

KRX_ID=
KRX_PW=

# Supabase (SPEC D2 — 2026-08-15 정적 JSON에서 변경)
# 파이프라인은 service_role 키로 쓰기(RLS 우회), 웹은 anon 키로 읽기만 한다.
# service_role 키는 절대 웹 번들·클라이언트 코드에 넣지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
